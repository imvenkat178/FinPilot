# Docker Compose example. Copy to .env, generate a password, and replace the URL placeholder.
# Never commit .env. The application uses process environment variables; Compose loads this file.
FINPILOT_ENV=development
FINPILOT_PUBLIC_ORIGIN=http://localhost:8100
FINPILOT_BIND_ADDRESS=127.0.0.1
FINPILOT_PORT=8100

POSTGRES_DB=finpilot
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=
# URL-encode the generated password here; it must match POSTGRES_PASSWORD above.
FINPILOT_DATABASE_URL=postgresql+psycopg://finpilot:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/finpilot

# Optional local model. An empty model name allows discovery from the runtime's model list.
FINPILOT_LLM_BASE_URL=http://host.docker.internal:11434/v1
FINPILOT_LLM_MODEL=
FINPILOT_LLM_API_KEY=not-needed
FINPILOT_LLM_TIMEOUT=12
FINPILOT_LLM_MAX_TOKENS=384
FINPILOT_LLM_HEALTH_TTL=15
FINPILOT_LLM_FAILURE_COOLDOWN=5

# Hosted deployments: FINPILOT_ENV=production and an HTTPS public origin are required.
# Keep PostgreSQL private. A reverse proxy terminates HTTPS and preserves the public Host header.

# Optional read-only Plaid Transactions integration. Disabled until all four are set.
# Use sandbox for operator testing; production needs enabled Plaid application access.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
# Generate a Fernet key locally and store it securely; never commit a real key here.
FINPILOT_TOKEN_KEY=
