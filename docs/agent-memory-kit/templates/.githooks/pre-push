#!/bin/sh
# Agent memory checks before every push, mirroring .github/workflows/agent-memory.yml.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip once, deliberately: git push --no-verify
set -e

PYTHON=""
for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1 &&
     "$candidate" -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1; then
    PYTHON="$candidate"
    break
  fi
done
if [ -z "$PYTHON" ]; then
  echo "agent memory: Python 3.8 or newer not found; skipping the pre-push checks" >&2
  exit 0
fi

"$PYTHON" scripts/roadmap.py check
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null || true)
if [ -n "$upstream" ]; then
  "$PYTHON" scripts/check_handoff.py --base "$upstream"
else
  "$PYTHON" scripts/check_handoff.py
fi
